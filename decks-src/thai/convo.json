[
 {"id": "convo-morning", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "สวัสดีค่ะ", "cue_rom": "Sàwàtdii khâ.", "cue_en": "Hello. (any time of day)", "tl": "สวัสดีครับ", "rom": "Sàwàtdii khráp.", "en": "Hello.", "notes": "Thai uses สวัสดี at any hour; there is no everyday \"good morning\". Staff who are women end with ค่ะ (khâ) or คะ (khá); you, as a man, end with ครับ (khráp).", "confidence": "high"},
 {"id": "convo-howareyou", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "สบายดีไหมคะ", "cue_rom": "Sabaai dii mǎi khá?", "cue_en": "How are you?", "tl": "สบายดีครับ ขอบคุณครับ", "rom": "Sabaai dii khráp. Khàawpkhun khráp.", "en": "I'm fine, thank you.", "confidence": "high"},
 {"id": "convo-thanks", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "ขอบคุณมากค่ะ", "cue_rom": "Khàawpkhun mâak khâ.", "cue_en": "Thank you very much.", "tl": "ยินดีครับ", "rom": "Yindii khráp.", "en": "My pleasure.", "accept_tl": ["ไม่เป็นไรครับ", "Mâi pen rai khráp."], "confidence": "high"},
 {"id": "convo-sorry", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Street", "cue": "ขอโทษค่ะ", "cue_rom": "Khǎawthôot khâ!", "cue_en": "Oh, excuse me, I'm sorry!", "tl": "ไม่เป็นไรครับ", "rom": "Mâi pen rai khráp.", "en": "It's okay, never mind.", "confidence": "high"},
 {"id": "convo-goodbye", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "ลาก่อนค่ะ โชคดีนะคะ", "cue_rom": "Laa kàwn khâ. Chôok dii ná khá.", "cue_en": "Goodbye, good luck.", "tl": "ขอบคุณครับ สวัสดีครับ", "rom": "Khàawpkhun khráp. Sàwàtdii khráp.", "en": "Thank you. Goodbye.", "notes": "สวัสดี is also used for goodbye.", "confidence": "high"},
 {"id": "convo-speak", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "พูดภาษาไทยได้ไหมคะ", "cue_rom": "Phûut phaasǎa Thai dâai mǎi khá?", "cue_en": "Do you speak Thai?", "tl": "ได้นิดหน่อยครับ", "rom": "Dâai nítnàwi khráp.", "en": "A little.", "confidence": "high"},
 {"id": "convo-understand", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "เข้าใจไหมคะ", "cue_rom": "Khâojai mǎi khá?", "cue_en": "Do you understand?", "tl": "ขอโทษครับ ไม่เข้าใจครับ", "rom": "Khǎawthôot khráp. Mâi khâojai khráp.", "en": "Sorry, I don't understand.", "confidence": "high"},
 {"id": "convo-slowly", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "พูดอีกครั้งไหมคะ", "cue_rom": "Phûut ìik khráng mǎi khá?", "cue_en": "Shall I say it again?", "tl": "ครับ พูดช้าๆหน่อยครับ", "rom": "Khráp. Phûut cháa cháa nàwi khráp.", "en": "Yes, please speak slowly.", "confidence": "high"},
 {"id": "convo-from", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "มาจากไหนคะ", "cue_rom": "Maa jàak nǎi khá?", "cue_en": "Where are you from?", "tl": "ผมมาจากอเมริกาครับ", "rom": "Phǒm maa jàak Àmeeríkaa khráp.", "en": "I'm from America.", "confidence": "high"},
 {"id": "convo-name", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "ชื่ออะไรคะ", "cue_rom": "Chûue àrai khá?", "cue_en": "What's your name?", "tl": "ผมชื่อลอยด์ครับ", "rom": "Phǒm chûue Lloyd khráp.", "en": "My name is Lloyd.", "confidence": "high"},
 {"id": "convo-firsttime", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Small talk", "cue": "มาเมืองไทยครั้งแรกหรือเปล่าคะ", "cue_rom": "Maa Mueang Thai khráng râaek rǔue plàao khá?", "cue_en": "Is this your first time in Thailand?", "tl": "ใช่ครับ ครั้งแรกครับ", "rom": "Châi khráp. Khráng râaek khráp.", "en": "Yes, it's my first time.", "confidence": "high"},
 {"id": "convo-howlong", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Small talk", "cue": "จะอยู่นานเท่าไหร่คะ", "cue_rom": "Jà yùu naan thâorài khá?", "cue_en": "How long are you staying?", "tl": "หนึ่งอาทิตย์ครับ", "rom": "Nùeng aathít khráp.", "en": "One week.", "confidence": "high"},
 {"id": "convo-likeit", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Small talk", "cue": "ชอบเมืองไทยไหมคะ", "cue_rom": "Châawp Mueang Thai mǎi khá?", "cue_en": "Do you like Thailand?", "tl": "ชอบมากครับ", "rom": "Châawp mâak khráp.", "en": "I like it a lot.", "confidence": "high"},
 {"id": "convo-howmany", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "กี่ท่านคะ", "cue_rom": "Kìi thân khá?", "cue_en": "How many people?", "tl": "สองคนครับ", "rom": "Sǎawng khon khráp.", "en": "Two people.", "confidence": "high"},
 {"id": "convo-order", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Café", "cue": "รับอะไรดีคะ", "cue_rom": "Ráp àrai dii khá?", "cue_en": "What would you like?", "tl": "ขอกาแฟหนึ่งแก้วครับ", "rom": "Khǎaw kaafaae nùeng kâaeo khráp.", "en": "One coffee, please.", "confidence": "high"},
 {"id": "convo-drink", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "รับเครื่องดื่มอะไรคะ", "cue_rom": "Ráp khrûueang dùuem àrai khá?", "cue_en": "What would you like to drink?", "tl": "ขอน้ำเปล่าครับ", "rom": "Khǎaw námplàao khráp.", "en": "Water, please.", "confidence": "high"},
 {"id": "convo-hereorgo", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Café", "cue": "ทานที่นี่หรือกลับบ้านคะ", "cue_rom": "Thaan thîi nîi rǔue klàp bâan khá?", "cue_en": "Eat here or take away?", "tl": "ทานที่นี่ครับ", "rom": "Thaan thîi nîi khráp.", "en": "Eat here, please.", "confidence": "high"},
 {"id": "convo-else", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "รับอะไรเพิ่มไหมคะ", "cue_rom": "Ráp àrai phôoem mǎi khá?", "cue_en": "Anything else?", "tl": "ไม่ครับ แค่นี้ครับ", "rom": "Mâi khráp. Khâae níi khráp.", "en": "No, that's all.", "confidence": "high"},
 {"id": "convo-taste", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "อาหารเป็นยังไงบ้างคะ", "cue_rom": "Aahǎan pen yang ngai bâang khá?", "cue_en": "How is the food?", "tl": "อร่อยมากครับ", "rom": "Àràwi mâak khráp.", "en": "It's very delicious.", "confidence": "high"},
 {"id": "convo-bill", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "ทานเสร็จแล้วใช่ไหมคะ", "cue_rom": "Thaan sèt láaeo châi mǎi khá?", "cue_en": "Have you finished?", "tl": "ครับ เช็คบิลด้วยครับ", "rom": "Khráp. Chék bin dûai khráp.", "en": "Yes. The bill, please.", "confidence": "high"},
 {"id": "convo-cardcash", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Shop", "cue": "เงินสดหรือบัตรคะ", "cue_rom": "Ngoensòt rǔue bàt khá?", "cue_en": "Cash or card?", "tl": "จ่ายบัตรครับ", "rom": "Jàai bàt khráp.", "en": "By card, please.", "confidence": "high"},
 {"id": "convo-looking", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Shop", "cue": "มีอะไรให้ช่วยไหมคะ", "cue_rom": "Mii àrai hâi chûai mǎi khá?", "cue_en": "Can I help you?", "tl": "ดูเฉยๆครับ ขอบคุณครับ", "rom": "Duu chǒoei chǒoei khráp. Khàawpkhun khráp.", "en": "I'm just looking, thank you.", "confidence": "high"},
 {"id": "convo-bag", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Shop", "cue": "รับถุงไหมคะ", "cue_rom": "Ráp thǔng mǎi khá?", "cue_en": "Do you need a bag?", "tl": "ไม่เอาครับ", "rom": "Mâi ao khráp.", "en": "No, thank you.", "notes": "Literally \"I do not want one\"; polite enough with ครับ.", "confidence": "high"},
 {"id": "convo-which", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Shop", "cue": "เอาอันไหนคะ", "cue_rom": "Ao an nǎi khá?", "cue_en": "Which one would you like?", "tl": "เอาอันนี้ครับ", "rom": "Ao an níi khráp.", "en": "This one, please.", "confidence": "high"},
 {"id": "convo-receipt", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Shop", "cue": "รับใบเสร็จไหมคะ", "cue_rom": "Ráp baisèt mǎi khá?", "cue_en": "Would you like a receipt?", "tl": "รับครับ", "rom": "Ráp khráp.", "en": "Yes, please.", "notes": "Thai answers yes by repeating the verb: รับ = (I will) take it.", "confidence": "high"},
 {"id": "convo-taxi", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Taxi", "cue": "ไปไหนครับ", "cue_rom": "Pai nǎi khráp?", "cue_en": "Where are you going?", "tl": "ไปสถานีรถไฟครับ", "rom": "Pai sàthǎanii rótfai khráp.", "en": "To the train station, please.", "confidence": "high"},
 {"id": "convo-ticket", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Station", "cue": "เที่ยวเดียวหรือไปกลับคะ", "cue_rom": "Thîao diao rǔue pai klàp khá?", "cue_en": "One way or round trip?", "tl": "เที่ยวเดียวครับ", "rom": "Thîao diao khráp.", "en": "One way, please.", "confidence": "high"},
 {"id": "convo-help", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Street", "cue": "ให้ช่วยไหมคะ", "cue_rom": "Hâi chûai mǎi khá?", "cue_en": "Do you need help?", "tl": "ครับ ห้องน้ำอยู่ที่ไหนครับ", "rom": "Khráp. Hâwngnáam yùu thîi nǎi khráp?", "en": "Yes. Where is the toilet?", "confidence": "high"},
 {"id": "convo-stophere", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Taxi", "cue": "จอดตรงนี้ได้ไหมครับ", "cue_rom": "Jàawt trong níi dâai mǎi khráp?", "cue_en": "Is stopping here okay?", "tl": "ได้ครับ จอดตรงนี้ครับ", "rom": "Dâai khráp. Jàawt trong níi khráp.", "en": "Yes, stop here, please.", "confidence": "high"},
 {"id": "convo-checkin", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Hotel", "cue": "สวัสดีค่ะ เช็คอินใช่ไหมคะ", "cue_rom": "Sàwàtdii khâ. Chék in châi mǎi khá?", "cue_en": "Hello. Are you checking in?", "tl": "ใช่ครับ ผมจองห้องไว้ครับ", "rom": "Châi khráp. Phǒm jaawng hâwng wái khráp.", "en": "Yes, I have booked a room.", "confidence": "high"},
 {"id": "convo-passport", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Hotel", "cue": "ขอพาสปอร์ตด้วยค่ะ", "cue_rom": "Khǎaw pháatsàpàawt dûai khâ.", "cue_en": "Your passport, please.", "tl": "นี่ครับ", "rom": "Nîi khráp.", "en": "Here you are.", "confidence": "high"},
 {"id": "convo-nights", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Hotel", "cue": "พักกี่คืนคะ", "cue_rom": "Phák kìi khuuen khá?", "cue_en": "How many nights?", "tl": "สามคืนครับ", "rom": "Sǎam khuuen khráp.", "en": "Three nights.", "confidence": "high"},
 {"id": "convo-room", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Hotel", "cue": "ห้องโอเคไหมคะ", "cue_rom": "Hâwng ookhee mǎi khá?", "cue_en": "Is the room okay?", "tl": "ดีมากครับ", "rom": "Dii mâak khráp.", "en": "Very good.", "confidence": "high"},
 {"id": "convo-okay", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Help", "cue": "เป็นอะไรไหมคะ", "cue_rom": "Pen àrai mǎi khá?", "cue_en": "Are you okay?", "tl": "ไม่เป็นไรครับ ขอบคุณครับ", "rom": "Mâi pen rai khráp. Khàawpkhun khráp.", "en": "I'm fine, thank you.", "confidence": "high"},
 {"id": "convo-hurt", "type": "dialog", "topic": "convo", "tier": 3, "scene": "Help", "cue": "เจ็บตรงไหนคะ", "cue_rom": "Jèp trong nǎi khá?", "cue_en": "Where does it hurt?", "tl": "เจ็บขาครับ", "rom": "Jèp khǎa khráp.", "en": "My leg hurts.", "confidence": "high"},
 {"id": "convo-photo", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Sights", "cue": "ช่วยถ่ายรูปให้หน่อยได้ไหมคะ", "cue_rom": "Chûai thàai rûup hâi nàwi dâai mǎi khá?", "cue_en": "Could you take a photo of us?", "tl": "ได้ครับ", "rom": "Dâai khráp.", "en": "Sure.", "confidence": "high"},
 {"id": "convo-seat", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Train", "cue": "ที่นั่งนี้ว่างไหมคะ", "cue_rom": "Thîi nâng níi wâang mǎi khá?", "cue_en": "Is this seat free?", "tl": "ว่างครับ เชิญครับ", "rom": "Wâang khráp. Chooen khráp.", "en": "It's free, go ahead.", "confidence": "high"}
