[
 {"id": "convo-morning", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "おはようございます。", "cue_rom": "Ohayō gozaimasu.", "cue_en": "Good morning.", "tl": "おはようございます。", "rom": "Ohayō gozaimasu.", "en": "Good morning.", "notes": "Used until about 10 or 11 in the morning; after that こんにちは.", "confidence": "high"},
 {"id": "convo-howareyou", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "こんにちは。お元気ですか。", "cue_rom": "Konnichiwa. Ogenki desu ka.", "cue_en": "Hello, how are you?", "tl": "はい、元気です。ありがとうございます。", "rom": "Hai, genki desu. Arigatō gozaimasu.", "en": "Yes, I'm fine. Thank you.", "confidence": "high"},
 {"id": "convo-thanks", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "どうもありがとうございます。", "cue_rom": "Dōmo arigatō gozaimasu.", "cue_en": "Thank you very much.", "tl": "どういたしまして。", "rom": "Dō itashimashite.", "en": "You're welcome.", "accept_tl": ["いえいえ。", "Ie ie."], "confidence": "high"},
 {"id": "convo-sorry", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Street", "cue": "あ、すみません！", "cue_rom": "A, sumimasen!", "cue_en": "Oh, excuse me, I'm sorry!", "tl": "大丈夫です。", "rom": "Daijōbu desu.", "en": "It's okay.", "confidence": "high"},
 {"id": "convo-goodbye", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Greeting", "cue": "ありがとうございました。お気をつけて。", "cue_rom": "Arigatō gozaimashita. Oki o tsukete.", "cue_en": "Thank you very much. Take care.", "tl": "ありがとうございます。さようなら。", "rom": "Arigatō gozaimasu. Sayōnara.", "en": "Thank you. Goodbye.", "confidence": "high"},
 {"id": "convo-speak", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "日本語を話せますか。", "cue_rom": "Nihongo o hanasemasu ka.", "cue_en": "Do you speak Japanese?", "tl": "少しだけです。", "rom": "Sukoshi dake desu.", "en": "Only a little.", "accept_tl": ["少しだけ話せます。", "Sukoshi dake hanasemasu."], "confidence": "high"},
 {"id": "convo-understand", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "わかりますか。", "cue_rom": "Wakarimasu ka.", "cue_en": "Do you understand?", "tl": "すみません、わかりません。", "rom": "Sumimasen, wakarimasen.", "en": "Sorry, I don't understand.", "confidence": "high"},
 {"id": "convo-slowly", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "もう一度言いましょうか。", "cue_rom": "Mō ichido iimashō ka.", "cue_en": "Shall I say it again?", "tl": "はい、ゆっくりお願いします。", "rom": "Hai, yukkuri onegai shimasu.", "en": "Yes, more slowly, please.", "confidence": "high"},
 {"id": "convo-from", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "どちらからですか。", "cue_rom": "Dochira kara desu ka.", "cue_en": "Where are you from?", "tl": "アメリカから来ました。", "rom": "Amerika kara kimashita.", "en": "I'm from America.", "confidence": "high"},
 {"id": "convo-name", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Small talk", "cue": "お名前は？", "cue_rom": "Onamae wa?", "cue_en": "What's your name?", "tl": "ロイドです。", "rom": "Roido desu.", "en": "I'm Lloyd.", "confidence": "high"},
 {"id": "convo-firsttime", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Small talk", "cue": "日本は初めてですか。", "cue_rom": "Nihon wa hajimete desu ka.", "cue_en": "Is this your first time in Japan?", "tl": "はい、初めてです。", "rom": "Hai, hajimete desu.", "en": "Yes, it's my first time.", "confidence": "high"},
 {"id": "convo-howlong", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Small talk", "cue": "どのくらい滞在しますか。", "cue_rom": "Dono kurai taizai shimasu ka.", "cue_en": "How long are you staying?", "tl": "一週間です。", "rom": "Isshūkan desu.", "en": "One week.", "confidence": "high"},
 {"id": "convo-likeit", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Small talk", "cue": "日本は好きですか。", "cue_rom": "Nihon wa suki desu ka.", "cue_en": "Do you like Japan?", "tl": "はい、大好きです。", "rom": "Hai, daisuki desu.", "en": "Yes, I like it very much.", "confidence": "high"},
 {"id": "convo-howmany", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "何名様ですか。", "cue_rom": "Nanmei-sama desu ka.", "cue_en": "How many people?", "tl": "二人です。", "rom": "Futari desu.", "en": "Two people.", "notes": "You can also just hold up two fingers.", "confidence": "high"},
 {"id": "convo-order", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Café", "cue": "ご注文は何になさいますか。", "cue_rom": "Go-chūmon wa nani ni nasaimasu ka.", "cue_en": "What would you like to order?", "tl": "コーヒーをお願いします。", "rom": "Kōhī o onegai shimasu.", "en": "A coffee, please.", "confidence": "high"},
 {"id": "convo-drink", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "お飲み物はいかがですか。", "cue_rom": "Onomimono wa ikaga desu ka.", "cue_en": "Anything to drink?", "tl": "お水をください。", "rom": "Omizu o kudasai.", "en": "Water, please.", "confidence": "high"},
 {"id": "convo-hereorgo", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Café", "cue": "店内でお召し上がりですか。", "cue_rom": "Tennai de omeshiagari desu ka.", "cue_en": "Are you eating in?", "tl": "はい、店内でお願いします。", "rom": "Hai, tennai de onegai shimasu.", "en": "Yes, eating in, please.", "notes": "To take away: 持ち帰りでお願いします (mochikaeri de onegai shimasu).", "confidence": "high"},
 {"id": "convo-else", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "以上でよろしいですか。", "cue_rom": "Ijō de yoroshii desu ka.", "cue_en": "Will that be all?", "tl": "はい、以上です。", "rom": "Hai, ijō desu.", "en": "Yes, that's all.", "confidence": "high"},
 {"id": "convo-taste", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "お味はいかがですか。", "cue_rom": "Oaji wa ikaga desu ka.", "cue_en": "How is the food?", "tl": "とてもおいしいです。", "rom": "Totemo oishii desu.", "en": "It's delicious.", "confidence": "high"},
 {"id": "convo-bill", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Restaurant", "cue": "お食事はお済みですか。", "cue_rom": "O-shokuji wa osumi desu ka.", "cue_en": "Have you finished your meal?", "tl": "はい。お会計をお願いします。", "rom": "Hai. Okaikei o onegai shimasu.", "en": "Yes. The bill, please.", "confidence": "high"},
 {"id": "convo-cardcash", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Shop", "cue": "お支払いは現金ですか、カードですか。", "cue_rom": "Oshiharai wa genkin desu ka, kādo desu ka.", "cue_en": "Cash or card?", "tl": "カードでお願いします。", "rom": "Kādo de onegai shimasu.", "en": "By card, please.", "confidence": "high"},
 {"id": "convo-looking", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Shop", "cue": "何かお探しですか。", "cue_rom": "Nanika osagashi desu ka.", "cue_en": "Are you looking for something?", "tl": "見ているだけです。ありがとうございます。", "rom": "Mite iru dake desu. Arigatō gozaimasu.", "en": "I'm just looking, thank you.", "confidence": "high"},
 {"id": "convo-bag", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Shop", "cue": "袋はご利用ですか。", "cue_rom": "Fukuro wa go-riyō desu ka.", "cue_en": "Do you need a bag?", "tl": "いいえ、大丈夫です。", "rom": "Iie, daijōbu desu.", "en": "No, I'm fine.", "notes": "Bags usually cost a few yen.", "confidence": "high"},
 {"id": "convo-which", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Shop", "cue": "どちらになさいますか。", "cue_rom": "Dochira ni nasaimasu ka.", "cue_en": "Which one would you like?", "tl": "これをお願いします。", "rom": "Kore o onegai shimasu.", "en": "This one, please.", "confidence": "high"},
 {"id": "convo-receipt", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Shop", "cue": "レシートはご利用ですか。", "cue_rom": "Reshīto wa go-riyō desu ka.", "cue_en": "Would you like a receipt?", "tl": "はい、お願いします。", "rom": "Hai, onegai shimasu.", "en": "Yes, please.", "confidence": "high"},
 {"id": "convo-taxi", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Taxi", "cue": "どちらまで行きますか。", "cue_rom": "Dochira made ikimasu ka.", "cue_en": "Where are you going?", "tl": "駅までお願いします。", "rom": "Eki made onegai shimasu.", "en": "To the station, please.", "confidence": "high"},
 {"id": "convo-ticket", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Station", "cue": "片道ですか、往復ですか。", "cue_rom": "Katamichi desu ka, ōfuku desu ka.", "cue_en": "One way or round trip?", "tl": "片道をお願いします。", "rom": "Katamichi o onegai shimasu.", "en": "One way, please.", "confidence": "high"},
 {"id": "convo-help", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Street", "cue": "何かお困りですか。", "cue_rom": "Nanika okomari desu ka.", "cue_en": "Do you need help?", "tl": "はい。トイレはどこですか。", "rom": "Hai. Toire wa doko desu ka.", "en": "Yes. Where is the toilet?", "confidence": "high"},
 {"id": "convo-stophere", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Taxi", "cue": "こちらでよろしいですか。", "cue_rom": "Kochira de yoroshii desu ka.", "cue_en": "Is here okay?", "tl": "はい、ここで大丈夫です。", "rom": "Hai, koko de daijōbu desu.", "en": "Yes, here is fine.", "confidence": "high"},
 {"id": "convo-checkin", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Hotel", "cue": "こんばんは。チェックインですか。", "cue_rom": "Konbanwa. Chekkuin desu ka.", "cue_en": "Good evening. Are you checking in?", "tl": "はい、予約しています。", "rom": "Hai, yoyaku shite imasu.", "en": "Yes, I have a reservation.", "confidence": "high"},
 {"id": "convo-passport", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Hotel", "cue": "パスポートをお願いします。", "cue_rom": "Pasupōto o onegai shimasu.", "cue_en": "Your passport, please.", "tl": "はい、どうぞ。", "rom": "Hai, dōzo.", "en": "Here you are.", "confidence": "high"},
 {"id": "convo-nights", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Hotel", "cue": "何泊ですか。", "cue_rom": "Nanpaku desu ka.", "cue_en": "How many nights?", "tl": "三泊です。", "rom": "Sanpaku desu.", "en": "Three nights.", "confidence": "high"},
 {"id": "convo-room", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Hotel", "cue": "お部屋はいかがですか。", "cue_rom": "Oheya wa ikaga desu ka.", "cue_en": "How is the room?", "tl": "とてもいいです。", "rom": "Totemo ii desu.", "en": "It's very nice.", "confidence": "high"},
 {"id": "convo-okay", "type": "dialog", "topic": "convo", "tier": 1, "scene": "Help", "cue": "大丈夫ですか。", "cue_rom": "Daijōbu desu ka.", "cue_en": "Are you okay?", "tl": "大丈夫です。ありがとうございます。", "rom": "Daijōbu desu. Arigatō gozaimasu.", "en": "I'm okay, thank you.", "confidence": "high"},
 {"id": "convo-hurt", "type": "dialog", "topic": "convo", "tier": 3, "scene": "Help", "cue": "どこが痛いですか。", "cue_rom": "Doko ga itai desu ka.", "cue_en": "Where does it hurt?", "tl": "足が痛いです。", "rom": "Ashi ga itai desu.", "en": "My leg hurts.", "notes": "足 (ashi) covers both leg and foot.", "confidence": "high"},
 {"id": "convo-photo", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Sights", "cue": "写真を撮っていただけますか。", "cue_rom": "Shashin o totte itadakemasu ka.", "cue_en": "Could you take a photo of us?", "tl": "はい、もちろんです。", "rom": "Hai, mochiron desu.", "en": "Yes, of course.", "confidence": "high"},
 {"id": "convo-seat", "type": "dialog", "topic": "convo", "tier": 2, "scene": "Train", "cue": "この席は空いていますか。", "cue_rom": "Kono seki wa aite imasu ka.", "cue_en": "Is this seat free?", "tl": "はい、どうぞ。", "rom": "Hai, dōzo.", "en": "Yes, go ahead.", "confidence": "high"}
]
