[
{"id": "basics-hello-01", "type": "phrase", "tl": "Dobrý den", "en": "hello", "accept": ["good day", "good afternoon"], "pos": "expr", "topic": "basics", "tier": 1, "notes": "The standard polite greeting all day. Say it when you walk into a shop, a lift or a waiting room.", "examples": [{"tl": "Dobrý den, máte volný stůl?", "en": "Hello, do you have a free table?"}], "confidence": "high"},
{"id": "basics-hi-01", "type": "vocab", "tl": "ahoj", "en": "hi", "accept": ["hello", "bye"], "pos": "interj", "topic": "basics", "tier": 2, "notes": "Casual, for friends and people you call 'ty'; also means bye. Hikers often greet each other with it on the trail.", "examples": [{"tl": "Ahoj, jak se máš?", "en": "Hi, how are you?"}], "confidence": "high"},
{"id": "basics-goodmorning-01", "type": "phrase", "tl": "Dobré ráno", "en": "good morning", "pos": "expr", "topic": "basics", "tier": 2, "notes": "Only early in the day, until about nine; after that say 'Dobrý den'.", "examples": [{"tl": "Dobré ráno, v kolik je snídaně?", "en": "Good morning, what time is breakfast?"}], "confidence": "high"},
{"id": "basics-goodevening-01", "type": "phrase", "tl": "Dobrý večer", "en": "good evening", "pos": "expr", "topic": "basics", "tier": 2, "notes": "From about six in the evening, for example when you walk into a restaurant.", "examples": [{"tl": "Dobrý večer, mám rezervaci na sedm hodin.", "en": "Good evening, I have a reservation for seven o'clock."}], "confidence": "high"},
{"id": "basics-goodnight-01", "type": "phrase", "tl": "Dobrou noc", "en": "good night", "pos": "expr", "topic": "basics", "tier": 3, "notes": "Only when someone is going to bed or leaving late at night.", "examples": [{"tl": "Děkuju a dobrou noc.", "en": "Thank you and good night."}], "confidence": "high"},
{"id": "basics-goodbye-01", "type": "phrase", "tl": "Na shledanou", "en": "goodbye", "accept": ["bye"], "accept_tl": ["Nashledanou", "Nashle"], "pos": "expr", "topic": "basics", "tier": 1, "notes": "Say it when leaving any shop, restaurant or lift. The 'sh' is two sounds: nas-khle-da-nou. Short casual form: Nashle.", "examples": [{"tl": "Děkuju, na shledanou.", "en": "Thank you, goodbye."}], "confidence": "high"},
{"id": "basics-please-01", "type": "vocab", "tl": "prosím", "en": "please", "accept": ["you're welcome", "here you are", "pardon"], "pos": "interj", "topic": "basics", "tier": 1, "notes": "Does four jobs: please, you're welcome, here you are, and 'Prosím?' = pardon? / yes, how can I help?", "examples": [{"tl": "Jednu kávu, prosím.", "en": "One coffee, please."}, {"tl": "– Děkuju. – Prosím.", "en": "– Thank you. – You're welcome."}], "confidence": "high"},
{"id": "basics-thanks-01", "type": "vocab", "tl": "děkuju", "en": "thank you", "accept": ["thanks"], "accept_tl": ["děkuji", "díky"], "pos": "interj", "topic": "basics", "tier": 1, "notes": "'Děkuji' is the more formal spelling; 'díky' is casual thanks.", "examples": [{"tl": "Děkuju za pomoc.", "en": "Thank you for your help."}], "confidence": "high"},
{"id": "basics-thanksalot-01", "type": "phrase", "tl": "Děkuju moc", "en": "thank you very much", "accept": ["thanks a lot", "thank you so much"], "accept_tl": ["Moc děkuju", "Děkuju mockrát", "Děkuji moc"], "pos": "expr", "topic": "basics", "tier": 3, "notes": "The example is said to a man; to a woman: jste hodná.", "examples": [{"tl": "Děkuju moc, jste hodný.", "en": "Thank you very much, you're kind."}], "confidence": "high"},
{"id": "basics-yourewelcome-01", "type": "phrase", "tl": "Není zač", "en": "you're welcome", "accept": ["don't mention it", "not at all"], "accept_tl": ["Prosím", "Rádo se stalo"], "pos": "expr", "topic": "basics", "tier": 3, "notes": "Literally 'there is nothing (to thank) for'. A plain 'Prosím' is just as common.", "examples": [{"tl": "– Děkuju za pomoc. – Není zač.", "en": "– Thank you for your help. – You're welcome."}], "confidence": "high"},
{"id": "basics-excuseme-01", "type": "vocab", "tl": "promiňte", "en": "excuse me", "accept": ["sorry", "I'm sorry"], "pos": "interj", "topic": "basics", "tier": 1, "notes": "Polite (vy) form: to get someone's attention or to apologize. To a friend: promiň.", "examples": [{"tl": "Promiňte, kde je metro?", "en": "Excuse me, where is the metro?"}], "confidence": "high"},
{"id": "basics-pardon-01", "type": "vocab", "tl": "pardon", "en": "sorry", "accept": ["pardon", "excuse me"], "pos": "interj", "topic": "basics", "tier": 2, "notes": "Quick apology when you bump into someone. A woman says 'nechtěla' in the example.", "examples": [{"tl": "Pardon, to jsem nechtěl.", "en": "Sorry, I didn't mean to."}], "confidence": "high"},
{"id": "basics-comingthrough-01", "type": "phrase", "tl": "S dovolením", "en": "may I get past", "accept": ["excuse me", "coming through", "with your permission"], "pos": "expr", "topic": "basics", "tier": 2, "notes": "Literally 'with permission'. What you say to squeeze past people on a tram or in a crowd.", "examples": [{"tl": "S dovolením, vystupuju.", "en": "Excuse me, I'm getting off."}], "confidence": "high"},
{"id": "basics-yes-01", "type": "vocab", "tl": "ano", "en": "yes", "accept_tl": ["jo"], "pos": "interj", "topic": "basics", "tier": 1, "notes": "In casual speech you mostly hear 'jo', and also 'no', which means yes or well, not no!", "examples": [{"tl": "Ano, děkuju.", "en": "Yes, thank you."}], "confidence": "high"},
{"id": "basics-no-01", "type": "vocab", "tl": "ne", "en": "no", "pos": "interj", "topic": "basics", "tier": 1, "notes": "Also 'not' in short answers: Dnes ne = not today.", "examples": [{"tl": "Ne, děkuju.", "en": "No, thank you."}], "confidence": "high"},
{"id": "basics-okay-01", "type": "vocab", "tl": "dobře", "en": "okay", "accept": ["OK", "fine", "well", "all right", "good"], "pos": "adv", "topic": "basics", "tier": 1, "notes": "The adverb of dobrý: 'well', and the everyday way to agree.", "examples": [{"tl": "Dobře, děkuju.", "en": "OK, thank you."}], "confidence": "high"},
{"id": "basics-dontunderstand-01", "type": "phrase", "tl": "Nerozumím.", "en": "I don't understand.", "pos": "phrase", "topic": "basics", "tier": 1, "examples": [{"tl": "Promiňte, nerozumím. Mluvíte anglicky?", "en": "Sorry, I don't understand. Do you speak English?"}], "confidence": "high"},
{"id": "basics-understand-01", "type": "phrase", "tl": "Rozumím.", "en": "I understand.", "pos": "phrase", "topic": "basics", "tier": 3, "notes": "The question to you is 'Rozumíte?' = do you understand?", "examples": [{"tl": "– Rozumíte? – Ano, rozumím.", "en": "– Do you understand? – Yes, I understand."}], "confidence": "high"},
{"id": "basics-speakenglish-01", "type": "phrase", "tl": "Mluvíte anglicky?", "en": "Do you speak English?", "pos": "phrase", "topic": "basics", "tier": 1, "notes": "Younger people in cities usually do. Starting with 'Dobrý den' first goes down much better.", "examples": [{"tl": "– Mluvíte anglicky? – Jen trochu.", "en": "– Do you speak English? – Only a little."}], "confidence": "high"},
{"id": "basics-nospeakczech-01", "type": "phrase", "tl": "Nemluvím česky.", "en": "I don't speak Czech.", "pos": "phrase", "topic": "basics", "tier": 1, "examples": [{"tl": "Promiňte, nemluvím česky.", "en": "Sorry, I don't speak Czech."}], "confidence": "high"},
{"id": "basics-littleczech-01", "type": "phrase", "tl": "Mluvím jen trochu česky.", "en": "I speak only a little Czech.", "accept": ["I only speak a little Czech."], "pos": "phrase", "topic": "basics", "tier": 2, "examples": [{"tl": "Mluvím jen trochu česky, mluvte prosím pomalu.", "en": "I speak only a little Czech, please speak slowly."}], "confidence": "high"},
{"id": "basics-repeat-01", "type": "phrase", "tl": "Můžete to zopakovat?", "en": "Can you repeat that?", "accept": ["Could you repeat that?"], "pos": "phrase", "topic": "basics", "tier": 2, "examples": [{"tl": "Promiňte, můžete to zopakovat?", "en": "Sorry, can you repeat that?"}], "confidence": "high"},
{"id": "basics-slower-01", "type": "phrase", "tl": "Pomaleji, prosím.", "en": "Slower, please.", "accept": ["More slowly, please."], "pos": "phrase", "topic": "basics", "tier": 2, "examples": [{"tl": "Nerozumím. Pomaleji, prosím.", "en": "I don't understand. Slower, please."}], "confidence": "high"},
{"id": "basics-howsay-01", "type": "phrase", "tl": "Jak se to řekne česky?", "en": "How do you say it in Czech?", "accept": ["How do you say that in Czech?"], "pos": "phrase", "topic": "basics", "tier": 3, "examples": [{"tl": "Jak se řekne česky „receipt“?", "en": "How do you say 'receipt' in Czech?"}], "confidence": "high"},
{"id": "basics-writedown-01", "type": "phrase", "tl": "Můžete mi to napsat?", "en": "Can you write it down for me?", "accept": ["Can you write that down?", "Can you write it down?"], "pos": "phrase", "topic": "basics", "tier": 3, "notes": "Useful for addresses, prices and train times.", "examples": [{"tl": "Můžete mi tu adresu napsat?", "en": "Can you write the address down for me?"}], "confidence": "high"},
{"id": "basics-i-01", "type": "vocab", "tl": "já", "en": "I", "accept": ["me"], "pos": "pron", "topic": "basics", "tier": 2, "notes": "Usually dropped, because the verb ending already shows who. Used for emphasis or contrast.", "examples": [{"tl": "Já jsem z Ameriky. A vy?", "en": "I'm from America. And you?"}, {"tl": "Já ne, děkuju.", "en": "Not me, thanks."}], "confidence": "high"},
{"id": "basics-you-01", "type": "vocab", "tl": "vy", "en": "you", "accept": ["you (polite)", "you (plural)"], "pos": "pron", "topic": "basics", "tier": 1, "notes": "Polite 'you' for any adult stranger or staff, and also plural you. 'Ty' is for friends, children and when invited.", "examples": [{"tl": "A vy?", "en": "And you?"}], "confidence": "high"},
{"id": "basics-that-01", "type": "vocab", "tl": "to", "en": "that", "accept": ["it", "this"], "accept_tl": ["tohle"], "pos": "pron", "topic": "basics", "tier": 1, "notes": "The pointing word. 'Tohle, prosím' while pointing gets you almost anything in a bakery.", "examples": [{"tl": "Co je to?", "en": "What is that?"}, {"tl": "Tohle, prosím.", "en": "This one, please."}], "confidence": "high"},
{"id": "basics-here-01", "type": "vocab", "tl": "tady", "en": "here", "accept_tl": ["tu", "zde"], "pos": "adv", "topic": "basics", "tier": 1, "notes": "'Zde' is the formal written form you see on signs.", "examples": [{"tl": "Je tady wifi?", "en": "Is there wifi here?"}], "confidence": "high"},
{"id": "basics-there-01", "type": "vocab", "tl": "tam", "en": "there", "pos": "adv", "topic": "basics", "tier": 1, "notes": "On doors TAM means push.", "examples": [{"tl": "Toalety jsou tam vzadu.", "en": "The toilets are back there."}], "confidence": "high"},
{"id": "basics-what-01", "type": "vocab", "tl": "co", "en": "what", "pos": "pron", "topic": "basics", "tier": 1, "notes": "Every waiter opens with 'Co si dáte?' = what will you have?", "examples": [{"tl": "Co si dáte?", "en": "What will you have?"}], "confidence": "high"},
{"id": "basics-and-01", "type": "vocab", "tl": "a", "en": "and", "pos": "conj", "topic": "basics", "tier": 1, "examples": [{"tl": "Pivo a vodu, prosím.", "en": "A beer and a water, please."}], "confidence": "high"},
{"id": "basics-or-01", "type": "vocab", "tl": "nebo", "en": "or", "pos": "conj", "topic": "basics", "tier": 2, "examples": [{"tl": "Čaj, nebo kávu?", "en": "Tea or coffee?"}], "confidence": "high"},
{"id": "basics-but-01", "type": "vocab", "tl": "ale", "en": "but", "pos": "conj", "topic": "basics", "tier": 2, "examples": [{"tl": "Je to hezké, ale drahé.", "en": "It's nice but expensive."}], "confidence": "high"},
{"id": "basics-with-01", "type": "vocab", "tl": "s", "en": "with", "accept_tl": ["se"], "pos": "prep", "topic": "basics", "tier": 2, "notes": "The next word takes the instrumental: s mlékem, s knedlíkem. Becomes 'se' before s- and z-: se sýrem.", "examples": [{"tl": "Kávu s mlékem, prosím.", "en": "Coffee with milk, please."}], "confidence": "high"},
{"id": "basics-without-01", "type": "vocab", "tl": "bez", "en": "without", "pos": "prep", "topic": "basics", "tier": 2, "notes": "The next word takes the genitive: bez masa, bez ledu, bez cukru.", "examples": [{"tl": "Čaj bez cukru, prosím.", "en": "Tea without sugar, please."}], "confidence": "high"},
{"id": "basics-big-01", "type": "vocab", "tl": "velký", "en": "big", "accept": ["large"], "pos": "adj", "topic": "basics", "tier": 2, "notes": "Agrees with the noun: velký stůl (m), velká káva (f), velké pivo (n).", "examples": [{"tl": "Jedno velké pivo, prosím.", "en": "One large beer, please."}], "confidence": "high"},
{"id": "basics-small-01", "type": "vocab", "tl": "malý", "en": "small", "accept": ["little"], "pos": "adj", "topic": "basics", "tier": 2, "notes": "malý / malá / malé. As the thing you order, the feminine becomes malou.", "examples": [{"tl": "Malou kávu, prosím.", "en": "A small coffee, please."}], "confidence": "high"},
{"id": "basics-good-01", "type": "vocab", "tl": "dobrý", "en": "good", "pos": "adj", "topic": "basics", "tier": 1, "notes": "dobrý / dobrá / dobré. For food, 'výborný' = excellent is the stronger compliment.", "examples": [{"tl": "To je dobrý nápad.", "en": "That's a good idea."}], "confidence": "high"},
{"id": "basics-bad-01", "type": "vocab", "tl": "špatný", "en": "bad", "accept": ["wrong"], "pos": "adj", "topic": "basics", "tier": 3, "notes": "Also 'wrong': špatný směr = the wrong direction.", "examples": [{"tl": "To je špatný vlak.", "en": "That's the wrong train."}], "confidence": "high"},
{"id": "basics-alot-01", "type": "vocab", "tl": "hodně", "en": "a lot", "accept": ["much", "many", "lots"], "pos": "adv", "topic": "basics", "tier": 2, "notes": "Followed by the genitive: hodně lidí, hodně času.", "examples": [{"tl": "V centru je hodně lidí.", "en": "There are a lot of people in the center."}], "confidence": "high"},
{"id": "basics-alittle-01", "type": "vocab", "tl": "trochu", "en": "a little", "accept": ["a bit", "some"], "pos": "adv", "topic": "basics", "tier": 2, "notes": "Followed by the genitive: trochu vody, trochu mléka.", "examples": [{"tl": "Ještě trochu vody, prosím.", "en": "A little more water, please."}], "confidence": "high"},
{"id": "basics-still-01", "type": "vocab", "tl": "ještě", "en": "still", "accept": ["more", "yet", "another"], "pos": "adv", "topic": "basics", "tier": 2, "notes": "With a number or thing it means 'another / more': ještě jedno pivo. Ještě ne = not yet.", "examples": [{"tl": "Ještě jednou, prosím.", "en": "Once more, please."}, {"tl": "Máte ještě otevřeno?", "en": "Are you still open?"}], "confidence": "high"},
{"id": "basics-dontknow-01", "type": "phrase", "tl": "Nevím.", "en": "I don't know.", "pos": "phrase", "topic": "basics", "tier": 2, "examples": [{"tl": "Nevím, nejsem odsud.", "en": "I don't know, I'm not from here."}], "confidence": "high"},
{"id": "basics-nevermind-01", "type": "phrase", "tl": "To nevadí.", "en": "It doesn't matter.", "accept": ["No problem.", "Never mind.", "That's all right."], "accept_tl": ["Nevadí."], "pos": "phrase", "topic": "basics", "tier": 2, "notes": "The easy answer to an apology or to bad news.", "examples": [{"tl": "– Bohužel nemáme anglické menu. – To nevadí.", "en": "– Unfortunately we don't have an English menu. – That's all right."}], "confidence": "high"},
{"id": "basics-unfortunately-01", "type": "vocab", "tl": "bohužel", "en": "unfortunately", "accept": ["sadly", "I'm afraid"], "pos": "adv", "topic": "basics", "tier": 3, "notes": "How staff soften a no: Bohužel ne = I'm afraid not.", "examples": [{"tl": "Bohužel máme plno.", "en": "Unfortunately we're full."}], "confidence": "high"}
]
